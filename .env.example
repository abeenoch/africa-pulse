# Copy to .env and fill in. NEVER commit .env.

# ClickHouse Cloud (console.clickhouse.cloud -> your service -> Connect)
# Host looks like: abc123.eu-west-1.aws.clickhouse.cloud
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# API keys
OPENAQ_API_KEY=

# Raw evidence store
RAW_DATA_DIR=./data/raw
QUARANTINE_DIR=./data/quarantine

# --- Airflow (only used by the `airflow` compose profile) ---
# Copy this file to .env.airflow before starting the airflow profile, then
# generate real secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=

# Postgres metadata DB credentials (consumed by the `postgres` service).
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_USERNAME=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_PASSWORD=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_DB=airflow

# Where the DAG finds the repository inside the container. The compose file
# bind-mounts the repo here; only override for non-Docker workers.
AFRICA_PULSE_DIR=/opt/airflow/africa-pulse

